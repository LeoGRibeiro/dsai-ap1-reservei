{
  "mcpServers": {
    "reservei": {
      "command": "python",
      "args": [
        "mcp_server/server.py"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1",
        "PYTHONIOENCODING": "utf-8"
      }
    }
  },
  "permissions": {
    "reservei": {
      "consultar_disponibilidade": "allow",
      "buscar_reservas_cliente": "allow",
      "criar_reserva": "ask"
    }
  }
}
